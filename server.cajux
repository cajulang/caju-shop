# The store's server and its commands:
#   ./server              serves (DATABASE_URL, required; PORT, default 3800; HOST; WORKERS
#                         processes; TRUSTED_PROXIES; SECURE_COOKIES; SHOP_DEMO_PAYMENTS: README)
#   ./server migrate      applies sql/*.sql
#   ./server seed --dev   demonstration data, with random passwords printed once (development)
#   ./server reset --dev  drops everything (development)
#   ./server sweep        removes expired sessions, abandoned carts and old sign-in attempts
import "std/os"
import "std/strings"
import "./shop"
import "./back/db"
import "./back/auth"
import "./back/catalog"
import "./back/seed"

fn has_flag(name: str) -> bool {
  for _, a := range os.args() { if a == name { return true } }
  return false
}

# seed and reset write or wipe the whole database: only with --dev, so they are never run by
# mistake against the store's real data
fn dev_only(cmd: str) {
  if has_flag("--dev") { return }
  os.eprintln(cmd + ": demonstration data is for development; run ./server " + cmd + " --dev")
  os.exit(2)
}

cmd := ""
if len(os.args()) > 1 { cmd = os.args()[1] }
if db.dsn() == "" {
  os.eprintln("set DATABASE_URL (postgres://user:password@host:port/database)")
  os.exit(2)
}
switch cmd {
case "migrate":
  applied := db.migrate("sql")
  print("migrations applied: " + str(len(applied)) + " " + strings.join(applied, " "))
case "seed":
  dev_only("seed")
  seed.run()
case "reset":
  dev_only("reset")
  seed.reset()
  print("database emptied (./server migrate && ./server seed --dev)")
case "sweep":
  print("removed " + str(auth.sweep()) + " rows")
default:
  port := os.getenv("PORT")
  if port == "" { port = "3800" }
  host := os.getenv("HOST")
  if host == "" { host = "127.0.0.1" }
  workers := catalog.atoi_or(os.getenv("WORKERS"), 1)
  err := shop.routes().run_workers(host + ":" + port, workers)
  if err != nil {
    os.eprintln(err.Error())
    os.exit(1)
  }
}
