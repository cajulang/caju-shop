  l := listing(c)
  p.admin.audit = admin.audit(&l)
  p.admin.listing = l
  render(c, p, 200)
}

# ---------------------------------------------------------------- files

fn dist() -> str {
  d := os.getenv("UI_DIST")
  if d == "" { return "dist" }
  return d
}

fn content_type(p: str) -> str {
  switch filepath.ext(p) {
  case ".js", ".mjs": return "text/javascript; charset=utf-8"
  case ".css": return "text/css; charset=utf-8"
  case ".wasm": return "application/wasm"
  case ".json": return "application/json"
  case ".svg": return "image/svg+xml"
  case ".html": return "text/html; charset=utf-8"
  }
  return "application/octet-stream"
}

let files_body = map[str]str{}
let files_gz = map[str]str{}
let files_tag = map[str]str{}

fn static_file(c: *web.Context) {
  clean := filepath.clean("/" + c.path())
  if c.method() == "GET" && clean != "/" && !strings.contains(clean, "..") {
    f := filepath.join(dist(), clean[1:])
    body, cached := files_body[f]
    if !cached && fs.is_file(f) {
      body, _ = fs.read_file(f)
      files_body[f] = body
      e := filepath.ext(f)
      if e == ".js" || e == ".mjs" || e == ".css" || e == ".wasm" || e == ".svg" { files_gz[f] = gzip.compress(body) }
      files_tag[f] = "\"" + str(hash.crc32(body) & 0xFFFFFFFF) + "-" + str(len(body)) + "\""
      cached = true
    }
    if cached {
      if c.query("v") != "" {
        c.set_header("Cache-Control", "public, max-age=31536000, immutable")
      } else {
        c.set_header("Cache-Control", "no-cache")
      }
      c.set_header("Vary", "Accept-Encoding")
      # the same file again (the worker and the wasm have no version in their URL): 304
      c.set_header("ETag", files_tag[f])
      if c.header("if-none-match") == files_tag[f] {
        c.data(304, content_type(f), "")
        return
      }
      gz, has := files_gz[f]
      if has && gzip.accepted(c.header("accept-encoding")) {
        c.set_header("Content-Encoding", "gzip")
        c.data(200, content_type(f), gz)
        return
      }
      c.data(200, content_type(f), body)
      return
    }
  }
  not_found(c)
}

# /img/p/<id>-<hue>.svg: the picture of a product (its department's figure in its hue)
let kinds = map[int]str{}

fn product_image(c: *web.Context) {
  name := strings.trim_suffix(c.param("file"), ".svg")
  parts := strings.split(name, "-")
  if len(parts) != 2 {
    c.string(404, "")
    return
  }
  id := catalog.atoi_or(parts[0], 0)
  hue := catalog.atoi_or(parts[1], 20)
  kind, ok := kinds[id]
  if !ok {
    r := db.row("select coalesce(top.slug, c.slug) as top from products p join categories c on c.id = p.category_id left join categories top on top.id = c.parent_id where p.id = $1", []any{id})
    kind = ""
    if r != nil { kind = r.get_str("top") }
    kinds[id] = kind
  }
  c.set_header("Cache-Control", "public, max-age=31536000, immutable")
  send(c, 200, "image/svg+xml", images.product_svg(kind, hue))
}

# ---------------------------------------------------------------- the routes

fn routes() -> *web.Engine {
  r := web.new()
  r.use(web.recovery())
  if os.getenv("UI_DEV") == "" && os.getenv("QUIET") == "" { r.use(web.logger()) }
  # the page runs the program in a worker with SharedArrayBuffer: every response is cross-origin isolated
  r.use(fn(c: *web.Context) {
    ssr.isolate(c.response)
    c.next()
  })
  r.use(same_origin)
  r.redirect_trailing_slash = false

  r.get("/", public(home_page))
  r.get("/busca", public(search_page))
  r.get("/categoria/:slug", public(category_page))
  r.get("/produto/:slug", public(product_page))
  r.get("/img/p/:file", product_image)
  r.get("/carrinho", cart_page)
  r.post("/carrinho", cart_add)
  r.post("/carrinho/:id", cart_set)
  r.get("/finalizar", checkout_page)
  r.post("/finalizar", checkout_post)
  r.get("/pedidos/:id", order_page)
  r.post("/pedidos/:id/pagar", order_action("paid"))
  r.post("/pedidos/:id/cancelar", order_action("canceled"))
  r.get("/entrar", login_page)
  r.post("/entrar", login_post)
  r.get("/cadastro", signup_page)
  r.post("/cadastro", signup_post)
  r.post("/sair", logout)
  r.get("/conta", account_page)
  r.post("/conta", account_post)
  r.get("/conta/pedidos", my_orders)
  r.post("/conta/enderecos", address_post)
  r.post("/conta/enderecos/:id/remover", address_delete)

  r.post("/api/carrinho", api_cart_add)
  r.post("/api/carrinho/:id", api_cart_set)
  r.get("/api/sugestoes", api_suggest)
  r.get("/api/cotacao", api_quote)

  a := r.group("/admin")
  a.use(staff_only)
  a.get("", a_dashboard)
  a.get("/produtos", a_products)
  a.get("/produtos/novo", a_product_new)
  a.post("/produtos/novo", a_product_create)
  a.post("/produtos/lote", a_products_bulk)
  a.get("/produtos/:id", a_product)
  a.post("/produtos/:id", a_product_update)
  a.post("/produtos/:id/estoque", a_product_stock)
  a.get("/categorias", a_categories)
  a.post("/categorias", a_category_save)
  a.post("/categorias/:id", a_category_save)
  a.post("/categorias/:id/remover", a_category_delete)
  a.get("/secoes", a_sections)
  a.post("/secoes", a_section_save)
  a.get("/secoes/:id", a_section)
  a.post("/secoes/:id", a_section_save)
  a.post("/secoes/:id/produtos", a_section_products)
  a.post("/secoes/:id/remover", a_section_delete)
  a.get("/pedidos", a_orders)
  a.get("/pedidos/:id", a_order)
  a.post("/pedidos/:id/situacao", a_order_status)
  a.get("/clientes", a_customers)
  a.get("/clientes/:id", a_customer)
  a.post("/clientes/:id/bloquear", a_customer_block)
  a.get("/cupons", a_coupons)
  a.post("/cupons", a_coupon_create)
  a.post("/cupons/:code/alternar", a_coupon_toggle)
  a.get("/configuracoes", a_settings)
  a.post("/configuracoes", a_settings_save)
  a.post("/fretes", a_rate_save)
  a.post("/fretes/:id", a_rate_save)
  a.post("/fretes/:id/remover", a_rate_delete)
  a.post("/equipe", a_staff_add)
  a.post("/equipe/:id", a_staff_role)
  a.get("/auditoria", a_audit)

  r.no_route(static_file)
  return r
}

# ---------------------------------------------------------------- the command line

cmd := ""
if len(os.args()) > 1 { cmd = os.args()[1] }
switch cmd {
case "migrate":
  applied := db.migrate("sql")
  print("migrations applied: " + str(len(applied)) + " " + strings.join(applied, " "))
case "seed":
  seed.run()
case "reset":
  seed.reset()
  print("database emptied (./server migrate && ./server seed)")
default:
  port := os.getenv("PORT")
  if port == "" { port = "3800" }
  host := os.getenv("HOST")
  if host == "" { host = "127.0.0.1" }
  workers := catalog.atoi_or(os.getenv("WORKERS"), 1)
  err := routes().run_workers(host + ":" + port, workers)
  if err != nil {
    os.eprintln(err.Error())
    os.exit(1)
  }
}
