}

fn a_order(c: *web.Context) { order_detail(c, id_param(c), map[str]str{}, 200) }

fn a_order_status(c: *web.Context) {
  f := fields(c)
  id := id_param(c)
  problem := orders.set_status(id, f["status"], f["note"], f["tracking"], actor(c))
  if problem != "" {
    key := "form"
    if f["status"] == "shipped" && strings.contains(problem, "rastreio") { key = "tracking" }
    order_detail(c, id, map[str]str{key: problem}, 422)
    return
  }
  if f["status"] == "canceled" { catalog.touch() }
  auth.audit(c, "mudou situação", "pedido", str(id), model.status_label(f["status"]))
  done(c, "Pedido: " + strings.to_lower(model.status_label(f["status"])) + ".", "/admin/pedidos/" + str(id))
}

