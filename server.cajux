fn a_settings(c: *web.Context) {
  if !editor_only(c) { return }
  settings_page(c, map[str]str{}, 200)
}

fn a_settings_save(c: *web.Context) {
  if !editor_only(c) { return }
  f := fields(c)
  name := strings.trim_space(f["store_name"])
  errs := map[str]str{}
  if len(name) < 2 { errs["store_name"] = "Dê um nome à loja." }
  free := 0
  if strings.trim_space(f["free_shipping"]) != "" {
    free = model.parse_reais(f["free_shipping"])
    if free < 0 { errs["free_shipping"] = "Informe um valor, como 250,00." }
  }
  if len(errs) > 0 {
    settings_page(c, errs, 422)
    return
  }
  db.exec("insert into settings (key, value) values ('store_name', $1), ('free_shipping_cents', $2) on conflict (key) do update set value = excluded.value", []any{name, str(free)})
  catalog.touch()
  auth.audit(c, "alterou", "configurações", "", "loja: " + name + "; frete grátis: " + model.money(free))
  done(c, "Configurações salvas.", "/admin/configuracoes")
}

fn rate_fields(f: map[str]str) -> (str, int, int, int, int) {
  lo := catalog.atoi_or(model.digits(f["cep_from"]), -1)
  hi := catalog.atoi_or(model.digits(f["cep_to"]), -1)
  price := model.parse_reais(f["price"])
  if strings.trim_space(f["price"]) == "0" || strings.trim_space(f["price"]) == "0,00" { price = 0 }
  if len(model.digits(f["cep_from"])) != 8 || len(model.digits(f["cep_to"])) != 8 || lo > hi || price < 0 || strings.trim_space(f["name"]) == "" { return "Confira a faixa: nome, CEPs com 8 dígitos (o inicial menor) e preço.", 0, 0, 0, 0 }
  return "", lo, hi, price, catalog.atoi_or(f["days"], 5)
}

fn a_rate_save(c: *web.Context) {
  if !editor_only(c) { return }
  f := fields(c)
  problem, lo, hi, price, days := rate_fields(f)
  if problem != "" {
    settings_page(c, map[str]str{"form": problem}, 422)
    return
  }
  id := id_param(c)
  if id == 0 {
    db.exec("insert into shipping_rates (name, cep_from, cep_to, price_cents, days) values ($1, $2, $3, $4, $5)", []any{strings.trim_space(f["name"]), lo, hi, price, days})
  } else {
    db.exec("update shipping_rates set name = $2, cep_from = $3, cep_to = $4, price_cents = $5, days = $6 where id = $1", []any{id, strings.trim_space(f["name"]), lo, hi, price, days})
  }
  auth.audit(c, "salvou", "frete", str(id), strings.trim_space(f["name"]) + ": " + model.money(price))
  done(c, "Frete salvo.", "/admin/configuracoes")
}

fn a_rate_delete(c: *web.Context) {
  if !editor_only(c) { return }
  db.exec("delete from shipping_rates where id = $1", []any{id_param(c)})
  auth.audit(c, "removeu", "frete", str(id_param(c)), "")
  done(c, "Faixa de frete removida.", "/admin/configuracoes")
}

fn a_staff_add(c: *web.Context) {
  if !editor_only(c) { return }
  f := fields(c)
  role := f["role"]
  if role != "admin" { role = "operator" }
  r := db.row("update customers set role = $2 where email = $1 returning id", []any{strings.to_lower(strings.trim_space(f["email"])), role})
  if r == nil {
    settings_page(c, map[str]str{"email": "Nenhum cliente com este e-mail. A pessoa precisa criar a conta antes."}, 422)
    return
  }
  auth.audit(c, "deu acesso", "equipe", str(r.get_int("id")), f["email"] + " como " + model.role_label(role))
  done(c, "Acesso concedido.", "/admin/configuracoes")
}

fn a_staff_role(c: *web.Context) {
  if !editor_only(c) { return }
  id := id_param(c)
  role := fields(c)["role"]
  if role != "admin" && role != "operator" { role = "customer" }
  if id == actor(c) && role != "admin" {
    fail(c, "Você não pode tirar o seu próprio acesso de administrador.", "/admin/configuracoes")
    return
  }
  db.exec("update customers set role = $2 where id = $1", []any{id, role})
  db.exec("delete from sessions where customer_id = $1", []any{id})
  auth.audit(c, "mudou papel", "equipe", str(id), model.role_label(role))
  done(c, "Papel alterado.", "/admin/configuracoes")
}

fn a_audit(c: *web.Context) {
  if !editor_only(c) { return }
