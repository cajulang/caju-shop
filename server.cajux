fn a_customer_block(c: *web.Context) {
  if !editor_only(c) { return }
  id := id_param(c)
  r := db.row("update customers set blocked = not blocked where id = $1 and role = 'customer' returning blocked", []any{id})
  if r == nil {
    not_found(c)
    return
  }
  msg := "Cliente desbloqueado."
  if r.get_bool("blocked") {
    msg = "Cliente bloqueado."
    db.exec("delete from sessions where customer_id = $1", []any{id})
  }
  auth.audit(c, strings.to_lower(strings.trim_suffix(msg, ".")), "cliente", str(id), "")
  done(c, msg, "/admin/clientes/" + str(id))
}

