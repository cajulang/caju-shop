# The pieces every page uses: the shell (the cart's count and the toasts, shared by context), the
# calls to the server's API, the header with the search and its suggestions, the product card,
# prices, form fields, breadcrumbs and pagination.
import ui "../caju-ui/ui"
import style "../caju-style/style"
import "std/strings"
import "std/strconv"
import "std/json"
import "./model"

# ---------------------------------------------------------------- the shell

export struct Shell {
  count: *ui.IntState     # the cart's count in the header
  toast: *ui.StrState     # a message that shows for a few seconds
  tone: *ui.StrState      # "ok" or "error"
}

export let SHELL = ui.create_context(nil)

export fn shell() -> *Shell { return ui.use_context(SHELL).(*Shell) }

export fn notify(s: *Shell, msg: str, tone: str) {
  s.tone.set(tone)
  s.toast.set(msg)
  ui.set_timeout(3200, fn() { s.toast.set("") })
}

# ---------------------------------------------------------------- talking to the server

# a request to the server from the browser (page function "api" in public/shop.js): done gets the
# HTTP status and the body
export fn api(method: str, url: str, body: str, done: fn(int, str)) {
  ui.call("api", method + "\n" + url + "\n" + body, fn(reply: str) {
    i := strings.index(reply, "\n")
    if i < 0 {
      done(0, "")
      return
    }
    code, _ := strconv.atoi(reply[0:i])
    done(code, reply[i + 1:])
  })
}

# the "error" of a JSON reply, or a generic message
export fn error_of(body: str) -> str {
  v, err := json.parse(body)
  if err == nil {
    e := v.get_str("error", "")
    if e != "" { return e }
  }
  return "Não foi possível falar com a loja. Tente de novo."
}

# a form body: key=value&...
export fn form(pairs: []str) -> str {
  out := []str{}
  for i := 0; i + 1 < len(pairs); i += 2 { out = append(out, pairs[i] + "=" + model.esc(pairs[i + 1])) }
  return strings.join(out, "&")
}

export fn visit(url: str) { ui.call("go", url, fn(r: str) {}) }

