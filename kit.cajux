export let badge_danger = style.def("badge-danger", "@badge bg-danger-soft text-danger")
export let badge_info = style.def("badge-info", "@badge bg-info-soft text-info")
export let alert_error = style.def("alert-error", "rounded-lg border border-danger/25 bg-danger-soft px-4 py-3 text-sm text-danger")
export let alert_ok = style.def("alert-ok", "rounded-lg border border-ok/25 bg-ok-soft px-4 py-3 text-sm text-ok")
export let alert_warn = style.def("alert-warn", "rounded-lg border border-warn/25 bg-warn-soft px-4 py-3 text-sm text-warn")
export let table = style.def("table", "w-full border-collapse text-sm [&_th]:border-b [&_th]:px-3 [&_th]:py-2.5 [&_th]:text-left [&_th]:text-xs [&_th]:font-semibold [&_th]:tracking-wide [&_th]:text-muted-foreground [&_th]:uppercase [&_td]:border-b [&_td]:px-3 [&_td]:py-2.5 [&_td]:align-middle [&_tr:last-child_td]:border-b-0")
