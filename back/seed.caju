# Demonstration data: the departments and their categories, about 200 products of the Northeast,
# the home's sections, coupons, shipping rates, customers and three months of orders.
#   ./shop seed       (on an empty database; ./shop reset drops everything first)
import "std/strings"
import "std/os"
import "./back/db"
import "./back/auth"
import "./back/catalog"

