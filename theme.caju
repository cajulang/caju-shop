# The store's look for caju style: the palette (cream, caju red, cashew-leaf green, sand), the
# fonts, the radii and the base rules.
#   theme.setup() before css.compile(style.registry())   (shop_css.caju)
import style "../caju-style/style"
import "std/strings"

const PALETTE = "background #fbf6ee, foreground #2a1d15, card #ffffff, muted #f3eadc, muted-foreground #75624f, border #e7dac6, input #dccbb2, primary #b8232e, primary-hover #96161f, primary-foreground #fff8ef, accent #2f5d3a, accent-soft #e3eee2, accent-foreground #ffffff, sale #d9480f, sale-soft #ffe8d9, warn #8a5a00, warn-soft #fff3cd, danger #a61b1b, danger-soft #fde2e1, ok #1f6b3a, ok-soft #ddf3e4, info #1f4e8c, info-soft #e1ecfb, ink #1b130e, ink-foreground #fbf6ee, ring #b8232e"

export fn setup() {
  rules := strings.Builder{}
  rules.write(":root {\n")
  for _, p := range strings.split(PALETTE, ", ") {
    kv := strings.split(p, " ")
    style.theme_inline_value("color-" + kv[0], "var(--" + kv[0] + ")")
    rules.write("  --" + kv[0] + ": " + kv[1] + ";\n")
  }
  rules.write("  --radius: 0.75rem;\n}")
  style.raw(rules.string())
  style.theme_inline_value("radius-sm", "calc(var(--radius) * 0.5)")
  style.theme_inline_value("radius-md", "calc(var(--radius) * 0.75)")
  style.theme_inline_value("radius-lg", "var(--radius)")
  style.theme_inline_value("radius-xl", "calc(var(--radius) * 1.4)")
  style.theme_inline_value("radius-2xl", "calc(var(--radius) * 1.8)")
  style.theme("font-sans", "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif")
  style.theme("font-serif", "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif")

  style.base("*", "border-border outline-ring/40")
  style.base("html", "antialiased font-sans [scroll-behavior:smooth] motion-reduce:[scroll-behavior:auto]")
  style.base("body", "flex min-h-dvh flex-col bg-background text-foreground text-[15px] leading-relaxed")
  style.base("#app", "contents")
  style.base("h1, h2, h3", "font-serif tracking-[-0.01em] text-foreground")
  style.base("a", "text-inherit [text-decoration:none]")
  style.base("::selection", "bg-primary/20")
}
