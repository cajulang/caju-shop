# The server's pure helpers, and (with SHOP_TEST_DSN) the rules that need the database: the stock
# cannot be oversold, a cancellation gives it back, coupons have limits.
#   caju test                                   the helpers
#   SHOP_TEST_DSN=postgres://... caju test      also against a database (it is emptied and seeded!)
import { describe, it, skip, expect } from "std/testing"
import "std/os"
import "std/strings"
import "./model"
import "./back/db"
import "./back/auth"
import "./back/catalog"
import "./back/orders"
import "./back/seed"
import "./back/limits"
import "std/fs"

describe("slugs and text", fn() {
  it("make addresses from names", fn() {
    expect(db.slugify("Doce de Leite 500 g")).to_equal("doce-de-leite-500-g")
    expect(db.slugify("Cachaça envelhecida em umburana")).to_equal("cachaca-envelhecida-em-umburana")
    expect(db.slugify("  Pão --- de   Açúcar!  ")).to_equal("pao-de-acucar")
  })
  it("escape LIKE patterns", fn() {
    expect(db.like("50%_off")).to_equal("%50\\%\\_off%")
  })
})

describe("the search's words", fn() {
  it("become a prefix tsquery, without the accents", fn() {
    expect(catalog.ts_query("Doce de leite")).to_equal("doce:* & de:* & leite:*")
    expect(catalog.ts_query("cachaça")).to_equal("cachaca:*")
  })
  it("cannot break the tsquery's syntax", fn() {
    expect(catalog.ts_query("a & b | !c:* (d)")).to_equal("a:* & b:* & c:* & d:*")
    expect(catalog.ts_query("  ")).to_equal("")
  })
})

describe("passwords", fn() {
  it("are checked against their hash, salted", fn() {
    h := auth.hash_password("segredo123")
    expect(h).to_start_with("pbkdf2$")
    expect(auth.check_password("segredo123", h)).to_be_true()
    expect(auth.check_password("segredo124", h)).to_be_false()
    expect(auth.hash_password("segredo123") == h).to_be_false()
    expect(auth.check_password("x", "lixo")).to_be_false()
  })
  it("tokens are 64 hex characters, never repeated", fn() {
    a := auth.token()
    expect(len(a)).to_equal(64)
    expect(a == auth.token()).to_be_false()
  })
})

describe("passwords: the work factor", fn() {
  it("is OWASP's minimum by default and is written in each hash", fn() {
    if os.getenv("SHOP_PBKDF2_ITERATIONS") == "" { expect(auth.current_iterations()).to_be_at_least(600000) }
    auth.set_iterations(1500)
    expect(auth.hash_password("x")).to_start_with("pbkdf2$1500$")
  })
  it("a hash with fewer iterations than today's is made again (needs_rehash)", fn() {
    auth.set_iterations(1000)
    old := auth.hash_password("segredo123")
    expect(auth.needs_rehash(old)).to_be_false()
    auth.set_iterations(2000)
    expect(auth.needs_rehash(old)).to_be_true()
    expect(auth.check_password("segredo123", old)).to_be_true()       # still checks
    expect(auth.needs_rehash(auth.hash_password("segredo123"))).to_be_false()
    expect(auth.needs_rehash("lixo")).to_be_true()
  })
  it("the demonstration accounts get random passwords", fn() {
    a := auth.random_password()
    expect(len(a)).to_equal(16)
    expect(a == auth.random_password()).to_be_false()
    expect(a == "admin123").to_be_false()
  })
})

describe("where a form sends the visitor back (safe_next)", fn() {
  it("keeps local paths", fn() {
    expect(limits.safe_next("/conta")).to_equal("/conta")
    expect(limits.safe_next("/busca?q=doce%20de%20leite&page=2")).to_equal("/busca?q=doce%20de%20leite&page=2")
    expect(limits.safe_next("/")).to_equal("/")
  })
  it("refuses CR/LF, tabs and other control characters (header injection, session fixation)", fn() {
    expect(limits.safe_next("/\r\nSet-Cookie: sid=abc")).to_equal("")
    expect(limits.safe_next("/conta\nX: y")).to_equal("")
    expect(limits.safe_next("/\t/evil.com")).to_equal("")       # browsers drop the tab: //evil.com
    expect(limits.safe_next("/\x00")).to_equal("")
    expect(limits.safe_next("/a b")).to_equal("")
    expect(limits.safe_next("/caf\xe9")).to_equal("")
  })
  it("refuses other hosts", fn() {
    expect(limits.safe_next("//evil.com")).to_equal("")
    expect(limits.safe_next("/\\evil.com")).to_equal("")
    expect(limits.safe_next("/a\\b")).to_equal("")
    expect(limits.safe_next("https://evil.com")).to_equal("")
    expect(limits.safe_next("evil.com")).to_equal("")
    expect(limits.safe_next("")).to_equal("")
    expect(limits.safe_next("/" + strings.repeat("a", 600))).to_equal("")
  })
})

describe("limits without a database", fn() {
  it("an address is its own key; IPv6 counts by /64", fn() {
    expect(limits.ip_key("203.0.113.9")).to_equal("203.0.113.9")
    expect(limits.ip_key("2001:db8:1:2:3:4:5:6")).to_equal("2001:db8:1:2::/64")
    expect(limits.ip_key("2001:db8:1:2:ffff::1")).to_equal("2001:db8:1:2::/64")
    expect(limits.ip_key("[2001:0db8::1]")).to_equal("2001:db8:0:0::/64")
    expect(limits.ip_key("::1")).to_equal("0:0:0:0::/64")
  })
  it("a window counts per key and starts over when it ends", fn() {
    s := 1000000000
    w := limits.new_window(2, 10 * s, 100)
    expect(w.allow("a", 0)).to_be_true()
    expect(w.allow("a", s)).to_be_true()
    expect(w.allow("a", 2 * s)).to_be_false()
    expect(w.allow("b", 2 * s)).to_be_true()
    expect(w.allow("a", 11 * s)).to_be_true()
  })
  it("a window never keeps more than max_keys keys", fn() {
    w := limits.new_window(1, 1000, 50)
    for i := 0; i < 500; i++ { w.allow("k" + str(i), 0) }
    expect(w.len()).to_be_at_most(50)
  })
  it("the hashing budget refuses once the window's share is spent, and says when to come back", fn() {
    s := 1000000000
    b := limits.new_budget(60 * s, 2 * s)
    expect(b.allow(0)).to_be_true()
    b.record(s, s)
    expect(b.allow(s)).to_be_true()
    b.record(2 * s, s)
    expect(b.allow(2 * s)).to_be_false()
    expect(b.retry_after(2 * s)).to_be_at_least(59)
    expect(b.allow(62 * s)).to_be_true()                     # the first hash left the window
  })
})

describe("the database in development (deploy/postgres.yaml)", fn() {
  it("is reachable only inside the cluster, with its password in a Secret", fn() {
    y, err := fs.read_file("deploy/postgres.yaml")
    expect(err).to_be_nil()
    expect(y).to_contain("type: ClusterIP")
    expect(y).not_().to_contain("LoadBalancer")
    expect(y).not_().to_contain("NodePort")
    expect(y).not_().to_contain("shop-dev")
    expect(y).to_contain("secretKeyRef")
  })
  it("the code has no password to fall back on", fn() {
    src, _ := fs.read_file("back/db.caju")
    expect(src).not_().to_contain("shop-dev")
    if os.getenv("DATABASE_URL") == "" {
      db.use("")
      expect(db.dsn()).to_equal("")
      expect(fn() { db.get() }).to_panic()
    }
  })
})

# ---------------------------------------------------------------- against the database

let DSN = os.getenv("SHOP_TEST_DSN")

fn dbit(title: str, body: fn()) {
  if DSN == "" {
    skip(title, body)
    return
  }
  it(title, body)
}

let ready = false

fn fresh() {
  if ready { return }
  auth.set_iterations(1000)
  db.use(DSN)
  seed.reset()
  db.migrate("sql")
  seed.run()
  ready = true
}

fn customer(email: str) -> int { return db.scalar_int("select id from customers where email = $1", []any{email}) }

describe("orders (database)", fn() {
  dbit("the last unit goes to one buyer only", fn() {
    fresh()
    pid := db.scalar_int("select id from products where active order by id limit 1", []any{})
    db.exec("update products set stock = 1 where id = $1", []any{pid})
    a := customer("cliente@emporiocaju.dev")
    b := db.scalar_int("select id from customers where role = 'customer' and id <> $1 order by id limit 1", []any{a})
    cart_a := auth.cart_of_customer(a)
    cart_b := auth.cart_of_customer(b)
    db.exec("delete from cart_items where cart_id in ($1, $2)", []any{cart_a, cart_b})
    expect(orders.cart_add(cart_a, pid, 1)).to_equal("")
    expect(orders.cart_add(cart_b, pid, 1)).to_equal("")
    expect(orders.cart_add(cart_b, pid, 1)).to_contain("Só há 1")
    addr_a := orders.addresses(a)[0].id
    addr_b := orders.addresses(b)[0].id
    id1, p1 := orders.place(a, cart_a, addr_a, "")
    expect(p1).to_equal("")
    expect(id1).to_be_greater_than(0)
    id2, p2 := orders.place(b, cart_b, addr_b, "")
    expect(id2).to_equal(0)
    expect(p2).to_contain("estoque")
    expect(db.scalar_int("select stock from products where id = $1", []any{pid})).to_equal(0)
    # cancelling gives the unit back
    expect(orders.set_status(id1, "canceled", "teste", "", 0)).to_equal("")
    expect(db.scalar_int("select stock from products where id = $1", []any{pid})).to_equal(1)
    expect(orders.set_status(id1, "paid", "", "", 0)).to_contain("não pode")
  })
  dbit("a coupon applies its rules", fn() {
    fresh()
    d, err := orders.coupon_discount("bemvindo10", 10000)
    expect(err).to_equal("")
    expect(d).to_equal(1000)
    _, e2 := orders.coupon_discount("CAJU20", 1000)
    expect(e2).to_contain("a partir de")
    _, e3 := orders.coupon_discount("NATAL2024", 10000)
    expect(e3).to_contain("expirou")
    _, e4 := orders.coupon_discount("NADA", 10000)
    expect(e4).to_contain("inválido")
  })
  dbit("shipping comes from the CEP's range, free above the threshold", fn() {
    fresh()
    m, price, days := orders.shipping("50030-230", 1000)
    expect(m).to_equal("Nordeste")
    expect(price).to_equal(1590)
    expect(days).to_equal(4)
    _, free, _ := orders.shipping("50030-230", 30000)
    expect(free).to_equal(0)
    none, _, _ := orders.shipping("123", 1000)
    expect(none).to_equal("")
  })
  dbit("the search finds words, stems and typos", fn() {
    fresh()
    s := catalog.search(catalog.Filters{q: "cachacas"}, "/busca")
    expect(s.total).to_be_greater_than(0)
    t := catalog.search(catalog.Filters{q: "queijo", stock: true, sort: "price-asc"}, "/busca")
    for i := 1; i < len(t.products); i++ { expect(model.current(t.products[i]) >= model.current(t.products[i - 1])).to_be_true() }
    u := catalog.search(catalog.Filters{q: "cocda"}, "/busca")
    expect(u.total).to_be_greater_than(0)
  })
})
